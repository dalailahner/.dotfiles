color-link default "white"
color-link comment "brightblack"
color-link identifier "cyan"
color-link constant "#df7020"
color-link constant.string "green"
color-link constant.number "#df7020"
color-link constant.bool "yellow"
color-link statement "magenta"
color-link preproc "brightblack"
color-link type "blue"
color-link special "magenta"
color-link underlined "red"
color-link error "bold red"
color-link todo "bold brightblack"
color-link hlsearch ",red"
color-link statusline "brightblack"
color-link indent-char "brightblack"
color-link line-number "brightblack"
color-link current-line-number "white"
color-link diff-added "green"
color-link diff-modified "#df7020"
color-link diff-deleted "red"
color-link gutter-error "red"
color-link gutter-warning "#df7020"
color-link match-brace ",red"
color-link tab-error "red"
color-link trailingws "red"
