{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/himeno-by-雨様.png",
    "padding": { "top": 1, "right": 1, "left": 0 },
    "width": 75
  },
  "display": {
    "separator": " │ ",
    "color": {
      "keys": "red",
      "separator": "red"
    },
    "constants": ["│\u001b[75C│\u001b[75D"]
  },
  "modules": [
    {
      "type": "title",
      "format": "{#31}╭─ {user-name}{#37}@{#36}{host-name} {#31}───────────────────────────────────────────────────╮"
    },
    {
      "type": "board",
      "key": "{$1}{#32}Board      "
    },
    {
      "type": "cpu",
      "key": "{$1}{#32}CPU        "
    },
    {
      "type": "gpu",
      "key": "{$1}{#32}GPU        ",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "{$1}{#32}RAM        "
    },
    {
      "type": "swap",
      "key": "{$1}{#32}Swap       "
    },
    {
      "type": "disk",
      "key": "{$1}{#32}Disk       ",
      "folders": "/"
    },
    {
      "type": "display",
      "key": "{$1}{#32}Display    "
    },
    {
      "type": "custom",
      "format": "{#31}{$1}            │"
    },
    {
      "type": "kernel",
      "key": "{$1}{#33}Kernel     "
    },
    {
      "type": "initsystem",
      "key": "{$1}{#33}InitSystem "
    },
    {
      "type": "lm",
      "key": "{$1}{#33}LM         "
    },
    {
      "type": "de",
      "key": "{$1}{#33}DE         "
    },
    {
      "type": "wm",
      "key": "{$1}{#33}WM         "
    },
    {
      "type": "packages",
      "key": "{$1}{#33}Packages   "
    },
    {
      "type": "custom",
      "format": "{#31}{$1}            │"
    },
    {
      "type": "theme",
      "key": "{$1}{#34}Theme      ",
      "format": "{1}"
    },
    {
      "type": "wmtheme",
      "key": "{$1}{#34}WM Theme   "
    },
    {
      "type": "icons",
      "key": "{$1}{#34}Icons      ",
      "format": "{1}"
    },
    {
      "type": "cursor",
      "key": "{$1}{#34}Cursor     "
    },
    {
      "type": "font",
      "key": "{$1}{#34}Font       ",
      "format": "{1}"
    },
    {
      "type": "custom",
      "format": "{#31}{$1}            │"
    },
    {
      "type": "terminal",
      "key": "{$1}{#35}Terminal   "
    },
    {
      "type": "terminalfont",
      "key": "{$1}{#35}Font       "
    },
    {
      "type": "shell",
      "key": "{$1}{#35}Shell      "
    },
    {
      "type": "editor",
      "key": "{$1}{#35}Editor     "
    },
    {
      "type": "custom",
      "format": "{#31}├─────────────┴─────────────────────────────────────────────────────────────┤"
    },
    {
      "type": "custom",
      "format": "{#31}{$1}{#40}  {#41}  {#42}  {#43}  {#44}  {#45}  {#46}  {#47}  {#49}{#31} Terminal img by 雨様 (@Yu_Yang6)"
    },
    {
      "type": "custom",
      "format": "{#31}{$1}{#100}  {#101}  {#102}  {#103}  {#104}  {#105}  {#106}  {#107}  {#49}{#31} Desktop Wallpaper by {$WALLPAPER_ARTIST}"
    },
    {
      "type": "custom",
      "format": "{#31}╰───────────────────────────────────────────────────────────────────────────╯"
    }
  ]
}
