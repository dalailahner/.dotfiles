{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/himeno-by-雨様.png",
    "padding": { "top": 1, "right": 1, "left": 0 },
    "width": 75
  },
  "display": {
    "separator": " │ ",
    "color": {
      "keys": "red",
      "separator": "red"
    },
    "constants": ["│\u001b[75C│\u001b[75D"]
  },
  "modules": [
    {
      "format": "{#31}╭─ {user-name}{#37}@{#36}{host-name} {#31}───────────────────────────────────────────────────╮",
      "type": "title"
    },
    {
      "key": "{$1}{#32}Board      ",
      "type": "board"
    },
    {
      "key": "{$1}{#32}CPU        ",
      "type": "cpu"
    },
    {
      "key": "{$1}{#32}GPU        ",
      "type": "gpu",
      "hideType": "integrated"
    },
    {
      "key": "{$1}{#32}RAM        ",
      "type": "memory"
    },
    {
      "key": "{$1}{#32}Swap       ",
      "type": "swap"
    },
    {
      "key": "{$1}{#32}Disk       ",
      "type": "disk",
      "folders": "/"
    },
    {
      "key": "{$1}{#32}Display    ",
      "type": "display"
    },
    {
      "format": "{#31}{$1}            │",
      "type": "custom"
    },
    {
      "key": "{$1}{#33}Kernel     ",
      "type": "kernel"
    },
    {
      "key": "{$1}{#33}InitSystem ",
      "type": "initsystem"
    },
    {
      "key": "{$1}{#33}LM         ",
      "type": "lm"
    },
    {
      "key": "{$1}{#33}DE         ",
      "type": "de"
    },
    {
      "key": "{$1}{#33}WM         ",
      "type": "wm"
    },
    {
      "key": "{$1}{#33}Packages   ",
      "type": "packages"
    },
    {
      "format": "{#31}{$1}            │",
      "type": "custom"
    },
    {
      "key": "{$1}{#34}Theme      ",
      "type": "theme",
      "format": "{1}"
    },
    {
      "key": "{$1}{#34}WM Theme   ",
      "type": "wmtheme"
    },
    {
      "key": "{$1}{#34}Icons      ",
      "type": "icons",
      "format": "{1}"
    },
    {
      "key": "{$1}{#34}Cursor     ",
      "type": "cursor"
    },
    {
      "key": "{$1}{#34}Font       ",
      "type": "font",
      "format": "{1}"
    },
    {
      "format": "{#31}{$1}            │",
      "type": "custom"
    },
    {
      "key": "{$1}{#35}Terminal   ",
      "type": "terminal"
    },
    {
      "key": "{$1}{#35}Font       ",
      "type": "terminalfont"
    },
    {
      "key": "{$1}{#35}Shell      ",
      "type": "shell"
    },
    {
      "key": "{$1}{#35}Editor     ",
      "type": "editor"
    },
    {
      "format": "{#31}├─────────────┴─────────────────────────────────────────────────────────────┤",
      "type": "custom"
    },
    {
      "format": "{#31}{$1}{#40}  {#41}  {#42}  {#43}  {#44}  {#45}  {#46}  {#47}  {#49}{#31} Terminal img by 雨様 (@Yu_Yang6)",
      "type": "custom"
    },
    {
      "format": "{#31}{$1}{#100}  {#101}  {#102}  {#103}  {#104}  {#105}  {#106}  {#107}  {#49}{#31} Wallpaper img by xxx",
      "type": "custom"
    },
    {
      "format": "{#31}╰───────────────────────────────────────────────────────────────────────────╯",
      "type": "custom"
    }
  ]
}
